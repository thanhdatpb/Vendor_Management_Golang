# Copy file này thành .env rồi điền giá trị (KHÔNG commit .env)
# Base URL của backend API. Để trống = same-origin (production dùng rewrite .htaccess).
# Dev local ví dụ: http://127.0.0.1:8000
VITE_API_URL=

# Pusher dùng để cập nhật thông báo ngay lập tức. Có thể bỏ trống khi build nằm
# cạnh thư mục backend: vite.config.js sẽ lấy PUSHER_APP_KEY/CLUSTER từ backend/.env.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
