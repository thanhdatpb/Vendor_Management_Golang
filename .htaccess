<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bỏ qua nếu đã được redirect nội bộ
  RewriteCond %{ENV:REDIRECT_STATUS} !^$
  RewriteRule ^ - [L]

  # 1. API/Sanctum/Storage -> Backend
  RewriteCond %{REQUEST_URI} ^/(api|sanctum|storage) [NC]
  RewriteRule ^(.*)$ backend/public/$1 [L]

  # 2. Mọi thứ khác -> Frontend React
  RewriteRule ^(.*)$ frontend/dist/$1 [L]
</IfModule>
