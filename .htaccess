<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Bỏ qua nếu đường dẫn hiện tại đã nằm trong backend/public hoặc frontend/dist
  RewriteRule ^(backend/public|frontend/dist)/ - [L]

  # 2. API/Sanctum/Storage -> Backend
  RewriteCond %{REQUEST_URI} ^/(api|sanctum|storage) [NC]
  RewriteRule ^(.*)$ backend/public/$1 [L]

  # 3. Mọi thứ khác -> Frontend React
  RewriteRule ^(.*)$ frontend/dist/$1 [L]
</IfModule>
